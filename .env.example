# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT].pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=5"
# For self-hosted: "postgresql://springhub:[PASSWORD]@localhost:5432/springhub"
# NOTE: Wajib pakai Supabase Pooler (port 5432 via pooler.supabase.com) + ?pgbouncer=true
#       untuk mencegah EMAXCONNSESSION. Jangan pakai port 6543 (direct).

# ─── JWT Secret (generate with: openssl rand -base64 48) ────────────────────
JWT_SECRET="your-random-64-char-hex-string"

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Cloudflare R2 (S3-compatible storage) ──────────────────────────────────
S3_ENDPOINT="https://[account-id].r2.cloudflarestorage.com"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="springhub-photos"
S3_PUBLIC_URL="https://pub-[hash].r2.dev"

# ─── Supabase (Storage + Database) ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..." # Service role key — wajib untuk upload foto

# ─── Xendit (Donations) ────────────────────────────────────────────────────
XENDIT_SECRET_KEY=""
XENDIT_WEBHOOK_TOKEN=""

# ─── Email (Password Reset) ─────────────────────────────────────────────────
# Options: "log" (dev), "resend", "sendgrid", "smtp"
EMAIL_PROVIDER="log"
EMAIL_API_KEY=""
EMAIL_FROM="noreply@springhub.id"
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="noreply@springhub.id"
SMTP_PASS=""

# ─── Sentry (Error Tracking) ────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""

# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="SpringHub"

# ─── Bull Queue ─────────────────────────────────────────────────────────────
REDIS_QUEUE_URL="redis://localhost:6379"

# Set to "true" to show DEMO badge in admin panel
NEXT_PUBLIC_DEMO_MODE=true

# Backup encryption passphrase (untuk encrypt backup DB)
BACKUP_ENCRYPT_KEY=""
REDIS_PASSWORD="CHANGE_ME_STRONG_RANDOM"

# IP whitelist untuk admin panel (optional, pisahkan dengan koma)
# Contoh: ADMIN_ALLOWED_IPS="192.168.1.100,10.0.0.0/8"
ADMIN_ALLOWED_IPS=""
