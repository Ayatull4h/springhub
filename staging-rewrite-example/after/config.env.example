# config/env.ts — 1 tempat baca env (STAGING: postgres:5432/springhub_staging)

DATABASE_URL="postgresql://springhub:${DB_PASSWORD}@postgres:5432/springhub_staging?connection_limit=5&pool_timeout=10"
REDIS_URL="redis://default:${REDIS_PASSWORD}@redis:6379/1"
JWT_SECRET="... staging only ..."
JWT_SECRET_PREVIOUS="... previous ..."
XENDIT_SECRET_KEY="${XENDIT_SECRET_KEY}"
XENDIT_WEBHOOK_TOKEN="${XENDIT_WEBHOOK_TOKEN}"
S3_PUBLIC_URL="${S3_PUBLIC_URL}"
RATE_PUBLIC="30/10000"  # 30 req / 10s
RATE_API="60/60000"
ADMIN_IPS=""  # kosong = izinkan semua (staging), prod isi CIDR
